DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://127.0.0.1:8080
BOT_TOKEN=123456:replace-me
BOT_USERNAME=deenly_bot
TELEGRAM_PROXY=
PERSONAL_BOT_MODE=True
BOT_OWNER_TELEGRAM_ID=
TIME_ZONE=Asia/Tashkent
# SQLite remains the default locally; production uses postgresql.
DATABASE_ENGINE=sqlite
SQLITE_PATH=
# Set all of these in production (not in Git). PostgreSQL has no public host port.
POSTGRES_DB=deenly
POSTGRES_USER=deenly
POSTGRES_PASSWORD=
# Docker production supplies this instead of a password in environment variables.
# POSTGRES_PASSWORD_FILE=/run/secrets/postgres_password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_CONN_MAX_AGE=60
POSTGRES_SSLMODE=prefer
# Server-only Quran Foundation Content API; prelive contains surahs 1 and 2 only.
QF_CLIENT_ID=""
QF_ENV=prelive
QF_RECITATION_ID=7
QF_RECITER_NAME=Mishary Rashid Alafasy
# Optional private JSON export (client_id, client_secret, environment).
# An ignored backend/runtime/quran-foundation/<QF_ENV>-credentials.json is auto-detected.
# QF_CREDENTIALS_FILE=/absolute/path/to/private/credentials.json
QF_CLIENT_SECRET=""
